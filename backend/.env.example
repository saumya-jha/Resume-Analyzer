# Copy this file to ".env" (same folder) and fill in your values.
# The real .env file is ignored by git, so your key is never uploaded.

# Required - get a key at https://console.groq.com
GROQ_API_KEY=your_groq_api_key_here

# Optional settings (defaults shown)
# GROQ_MODEL=openai/gpt-oss-120b
# LLM_TIMEOUT_SECONDS=30
# MAX_UPLOAD_MB=5
# MAX_PDF_PAGES=15
# MAX_RESUME_CHARS=20000

# Comma-separated list of websites allowed to call this API from a browser.
# 5173 is the default port of the Vite dev server used by the React frontend.
# CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
